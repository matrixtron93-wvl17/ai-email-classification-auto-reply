    {
      "parameters": {
        "jsCode": "const csv = $input.first().json.data;\n\nconst lines = csv.trim().split(/\\r?\\n/);\n\nconst headers = lines[0].split(',');\n\nconst emails = lines.slice(1).map(line => {\n  const values = line.split(',');\n\n  return {\n    id: values[0],\n    from_email: values[1],\n    subject: values[2],\n    body: values.slice(3).join(',')\n  };\n});\n\nreturn emails.map(email => ({\n  json: email\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        64
      ],
      "id": "644d2a0c-d9aa-40ac-852e-c910bc8e4219",
      "name": "Prepare Email Data"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3.5-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-3.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=You are an AI email classification assistant.\n\nClassify the incoming email into exactly ONE of these categories:\n\nSales\nSupport\nComplaint\nGeneral\n\nRules:\n\n- Sales: pricing, quotation, products, services, purchasing, or sales inquiries.\n- Support: login problems, technical issues, account problems, or requests for assistance.\n- Complaint: dissatisfaction, unresolved issues, poor service, delays, or negative customer experiences.\n- General: general questions or inquiries that do not clearly belong to Sales, Support, or Complaint.\n\nReturn ONLY valid JSON in this exact format:\n\n{\n  \"category\": \"Sales\",\n  \"confidence\": 95,\n  \"reason\": \"Brief explanation\"\n}\n\nEmail:\n\nFrom: {{ $json.from_email }}\n\nSubject: {{ $json.subject }}\n\nBody:\n{{ $json.body }}"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        672,
        64
      ],
      "id": "0ea70889-0e51-4350-8b99-c6915608a483",
      "name": "AI Email Classification",
      "credentials": {
        "googlePalmApi": {
          "id": "p58sHs9rhCniNJBi",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiItems = $input.all();\nconst originalItems = $('Prepare Email Data').all();\n\nreturn aiItems.map((item, index) => {\n  const original = originalItems[index].json;\n\n  const text = item.json.content?.parts?.[0]?.text || '';\n\n  const cleaned = text\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  let result;\n\n  try {\n    result = JSON.parse(cleaned);\n  } catch (error) {\n    result = {\n      category: 'General',\n      confidence: 0,\n      reason: 'Unable to parse AI classification result.'\n    };\n  }\n\n  return {\n    json: {\n      id: original.id,\n      from_email: original.from_email,\n      subject: original.subject,\n      body: original.body,\n      category: result.category,\n      confidence: Number(result.confidence) || 0,\n      reason: result.reason || ''\n    }\n  };\n});"
      },
